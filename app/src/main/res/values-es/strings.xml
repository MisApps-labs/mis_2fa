    <string name="onboarding_welcome_title">Te damos la bienvenida a Mis\u00A02FA</string>
    <string name="onboarding_welcome_message">Tus códigos de verificación en dos pasos, privados y libres. Sin anuncios, sin rastreo y sin necesidad de cuenta.</string>
    <string name="onboarding_how_title">Cómo funciona</string>
    <string name="onboarding_how_message">Cuando una web te pida activar la verificación en dos pasos, escanea el código QR que te muestre. A partir de ahí, Mis 2FA te dará un código nuevo cada 30 segundos: escríbelo al iniciar sesión. Toca un código para copiarlo.</string>
    <string name="onboarding_private_title">Tus códigos son solo tuyos</string>
    <string name="onboarding_private_message">Se guardan cifrados en este dispositivo y no salen de él salvo que tú quieras. Además, puedes bloquear la app con tu huella, tu cara o tu PIN.</string>
    <string name="onboarding_backup_title">No pierdas el acceso</string>
    <string name="onboarding_backup_message">Si pierdes el móvil, pierdes tus códigos. Guarda los códigos de recuperación que te da cada web y sincroniza con tu propio Nextcloud (cifrado de extremo a extremo) o exporta una copia cifrada desde Ajustes.</string>
    <string name="settings_tutorial">Ver tutorial</string>
    <string name="settings_tutorial_desc">Cómo funciona Mis 2FA y cómo no perder tus códigos</string>

