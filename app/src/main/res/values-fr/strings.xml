    <string name="onboarding_welcome_title">Bienvenue dans Mis\u00A02FA</string>
    <string name="onboarding_welcome_message">Vos codes de validation en deux étapes, privés et libres. Sans publicité, sans pistage et sans compte.</string>
    <string name="onboarding_how_title">Comment ça marche</string>
    <string name="onboarding_how_message">Quand un site vous demande d\'activer la validation en deux étapes, scannez le code QR qu\'il affiche. Mis 2FA vous donnera ensuite un nouveau code toutes les 30 secondes : saisissez-le lors de la connexion. Touchez un code pour le copier.</string>
    <string name="onboarding_private_title">Vos codes restent à vous</string>
    <string name="onboarding_private_message">Ils sont stockés chiffrés sur cet appareil et n\'en sortent que si vous le voulez. Vous pouvez aussi verrouiller l\'app avec votre empreinte, votre visage ou votre code PIN.</string>
    <string name="onboarding_backup_title">Ne perdez pas l\'accès</string>
    <string name="onboarding_backup_message">Si vous perdez votre téléphone, vous perdez vos codes. Gardez les codes de récupération fournis par chaque site, et synchronisez avec votre propre Nextcloud (chiffré de bout en bout) ou exportez une sauvegarde chiffrée depuis les Réglages.</string>
    <string name="settings_tutorial">Voir le tutoriel</string>
    <string name="settings_tutorial_desc">Comment fonctionne Mis 2FA et comment ne pas perdre vos codes</string>

