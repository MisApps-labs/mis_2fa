<!--
  Android 11 y anteriores: no se sube nada a la copia de seguridad en la nube de Google.
  Los códigos están cifrados con una clave del Keystore que no sale del dispositivo, así que una
  copia sería ilegible en otro móvil. La copia de seguridad de Mis 2FA es tu Nextcloud (cifrada)
  o el fichero que exportes desde Ajustes.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
