<!--
  Android 12+: ni copia en la nube ni transferencia entre dispositivos. Los datos van cifrados con
  una clave del Keystore de ESTE dispositivo y serían ilegibles en otro. Para pasar los códigos a
  un móvil nuevo usa la sincronización con Nextcloud o una copia de seguridad cifrada.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
