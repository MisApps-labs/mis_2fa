    <string name="onboarding_welcome_title">Welcome to Mis\u00A02FA</string>
    <string name="onboarding_welcome_message">Your two-step verification codes, private and free. No ads, no tracking and no account needed.</string>
    <string name="onboarding_how_title">How it works</string>
    <string name="onboarding_how_message">When a website asks you to turn on two-step verification, scan the QR code it shows you. Mis 2FA will then give you a new code every 30 seconds: type it in when you sign in. Tap a code to copy it.</string>
    <string name="onboarding_private_title">Your codes stay yours</string>
    <string name="onboarding_private_message">They\'re stored encrypted on this device and never leave it unless you want them to. You can also lock the app with your fingerprint, face or PIN.</string>
    <string name="onboarding_backup_title">Don\'t lose access</string>
    <string name="onboarding_backup_message">If you lose your phone, you lose your codes. Keep the recovery codes each website gives you, and sync with your own Nextcloud (end-to-end encrypted) or export an encrypted backup from Settings.</string>
    <string name="settings_tutorial">View tutorial</string>
    <string name="settings_tutorial_desc">How Mis 2FA works and how to keep your codes safe</string>

